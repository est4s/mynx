<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debian runs inside the app's process, so its networking (apt, curl, …) needs this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TerminalService keeps the shells running while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The wakelock setting: keeps the CPU awake while terminals run. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- pc26 location, only while the app is in use (never background location). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- A location stream started on screen keeps going in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- pc26 sensor step-counter and step-detector (Android 10+). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Quick photos (pc26 camera, quick option). Declaring it also makes Android require it
         for the camera app (pc26 camera). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- pc26 audio record; a recording started on screen keeps going in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The camera and microphone permissions would otherwise hide the app from phones without one. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".TerminalApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Other apps share files and text into Debian's share folder. -->
        <activity
            android:name=".ShareActivity"
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Serves the files `pc26 share` shares, only to the apps granted them. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="io.github.est4s.terminal.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The camera app writes the photo `pc26 camera` asked for here. -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="io.github.est4s.terminal.photo"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- specialUse: the time-limited types (dataSync, …) don't fit a terminal.
             location, microphone: added while `pc26 location` or `pc26 audio record` runs. -->
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's terminal sessions (shell processes) running while the app is in the background, like a terminal emulator." />
        </service>
    </application>
</manifest>
