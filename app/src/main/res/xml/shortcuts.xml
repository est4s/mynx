<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: Settings opens the settings editors (mynx edit) in a new tab.
     mynx dev has a copy in src/debug/res/xml: change both. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_settings">
        <intent
            android:action="io.github.est4s.terminal.SETTINGS"
            android:targetPackage="io.github.est4s.terminal"
            android:targetClass="io.github.est4s.terminal.MainActivity" />
    </shortcut>
    <!-- SPIKE (throwaway): the extended screen's streaming test. -->
    <shortcut
        android:shortcutId="spike_host"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_spike_host">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.est4s.terminal"
            android:targetClass="io.github.est4s.terminal.ScreenSpikeHostActivity" />
    </shortcut>
    <!-- SPIKE (throwaway): the extended screen's streaming test. -->
    <shortcut
        android:shortcutId="spike_show"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_spike_show">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.est4s.terminal"
            android:targetClass="io.github.est4s.terminal.ScreenSpikeShowActivity" />
    </shortcut>
</shortcuts>
