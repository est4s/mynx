+// mynx: the second monitor's part of the screen, stretched over the second surface.
+void Renderer::mynxDrawSecond(LorieBuffer* buffer, const LorieBuffer_Desc* desc, float xfactor) {
+    EGLSync fence;
+    if (eglMakeCurrent(egl_display, mynxSfc2, mynxSfc2, ctx) != EGL_TRUE)
+        return vprintEglError("eglMakeCurrent failed (second monitor)", __LINE__);
+
+    glDisable(GL_SCISSOR_TEST);
+    glViewport(0, 0, ANativeWindow_getWidth(mynxWin2), ANativeWindow_getHeight(mynxWin2));
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+
+    auto x = (float) mynxMonitorRect[1][0], y = (float) mynxMonitorRect[1][1];
+    auto w = (float) mynxMonitorRect[1][2], h = (float) mynxMonitorRect[1][3];
+    if (w > 0 && h > 0) {
+        lockServerState(state);
+        LorieBuffer_bindTexture(buffer);
+        drawRegion(0, -1.f, -1.f, 1.f, 1.f,
+                   x / (float) desc->width * xfactor, y / (float) desc->height,
+                   (x + w) / (float) desc->width * xfactor, (y + h) / (float) desc->height,
+                   LorieBuffer_isRgba(buffer));
+        fence = desc->type == LORIEBUFFER_FD ? EGL_NO_SYNC_KHR : eglCreateSyncKHR(egl_display, EGL_SYNC_FENCE_KHR, nullptr);
+        glFlush();
+        if (fence != EGL_NO_SYNC_KHR)
+            waitForFence(egl_display, fence, 0);
+        pthread_mutex_unlock(&state->lock);
+    }
+
+    if (eglSwapBuffers(egl_display, mynxSfc2) != EGL_TRUE)
+        printEglError("Failed to swap buffers (second monitor)", __LINE__);
+    if (eglMakeCurrent(egl_display, sfc, sfc, ctx) != EGL_TRUE)
+        vprintEglError("eglMakeCurrent failed (back from the second monitor)", __LINE__);
+}
+
+void Renderer::mynxSetSecondWindow(JNIEnv* env, jobject jsfc) {
+    ANativeWindow* newWin = jsfc ? ANativeWindow_fromSurface(env, jsfc) : nullptr;
+
+    pthread_mutex_lock(&stateLock);
+    while (mynxWin2Changed)
+        pthread_cond_wait(&stateChangeFinishCond, &stateLock);
+    mynxPendingWin2 = newWin;
+    mynxPendingSurface2 = newWin ? env->NewGlobalRef(jsfc) : nullptr;
+    mynxWin2Changed = true;
+    pthread_cond_signal(&stateCond);
+    // As setWindow: the renderer lets go of the old surface before Android destroys it.
+    while (mynxWin2Changed)
+        pthread_cond_wait(&stateChangeFinishCond, &stateLock);
+    pthread_mutex_unlock(&stateLock);
+}
+
+// On the renderer's thread, holding stateLock.
+void Renderer::mynxRefreshSecond() {
+    if (mynxSfc2 != EGL_NO_SURFACE) {
+        eglDestroySurface(egl_display, mynxSfc2);
+        mynxSfc2 = EGL_NO_SURFACE;
+    }
+    if (mynxWin2) {
+        ANativeWindow_release(mynxWin2);
+        mynxWin2 = nullptr;
+    }
+    if (mynxSurface2) {
+        rendererEnv->CallVoidMethod(mynxSurface2, surfaceRelease);
+        rendererEnv->ExceptionClear();
+        rendererEnv->DeleteGlobalRef(mynxSurface2);
+        mynxSurface2 = nullptr;
+    }
+
+    mynxWin2 = mynxPendingWin2;
+    mynxSurface2 = mynxPendingSurface2;
+    mynxPendingWin2 = nullptr;
+    mynxPendingSurface2 = nullptr;
+    mynxWin2Changed = false;
+    if (!mynxWin2)
+        return;
+
+    dprintf(2, "mynx: second surface %p %d %d\n", mynxWin2, ANativeWindow_getWidth(mynxWin2), ANativeWindow_getHeight(mynxWin2));
+    mynxSfc2 = eglCreateWindowSurface(egl_display, cfg, mynxWin2, nullptr);
+    if (mynxSfc2 == EGL_NO_SURFACE)
+        return vprintEglError("eglCreateWindowSurface failed (second monitor)", __LINE__);
+    if (eglMakeCurrent(egl_display, mynxSfc2, mynxSfc2, ctx) == EGL_TRUE)
+        eglSwapInterval(egl_display, 0);
+    eglMakeCurrent(egl_display, sfc, sfc, ctx);
