+// mynx: a second monitor (RandR output "mynx-b", its own CRTC) right of the first, the screen as wide as both.
+// The renderer draws each CRTC's part of the screen into its own surface (mynxMonitorRect).
+volatile int mynxMonitorRect[2][4];
+static RRCrtcPtr mynxCrtcs[2];
+static RROutputPtr mynxOutputs[2];
+static int mynxFirstW, mynxFirstH, mynxSecondW, mynxSecondH;
+
+static void mynxNoteCrtcs(void) {
+    for (int i = 0; i < 2; i++) {
+        RRCrtcPtr c = mynxCrtcs[i];
+        Bool on = c && c->mode;
+        mynxMonitorRect[i][0] = on ? c->x : 0;
+        mynxMonitorRect[i][1] = on ? c->y : 0;
+        mynxMonitorRect[i][2] = on ? c->mode->mode.width : 0;
+        mynxMonitorRect[i][3] = on ? c->mode->mode.height : 0;
+    }
+    dprintf(2, "mynx: monitors %dx%d+%d+%d and %dx%d+%d+%d\n",
+        mynxMonitorRect[0][2], mynxMonitorRect[0][3], mynxMonitorRect[0][0], mynxMonitorRect[0][1],
+        mynxMonitorRect[1][2], mynxMonitorRect[1][3], mynxMonitorRect[1][0], mynxMonitorRect[1][1]);
+    if (pvfb->state)
+        pvfb->state->drawRequested = TRUE;
+}
+
+static void mynxApplyMonitors(void) {
+    ScreenPtr pScreen = pScreenPtr;
+    RROutputPtr a = mynxOutputs[0], b = mynxOutputs[1];
+    RRModePtr modeA, modeB;
+    int width, height;
+
+    if (!pScreen || !a || !mynxFirstW || !mynxFirstH)
+        return;
+
+    modeA = lorieCvt(mynxFirstW, mynxFirstH, pvfb->root.framerate);
+    width = modeA->mode.width;
+    height = modeA->mode.height;
+    RROutputSetModes(a, &modeA, 1, 0);
+    RRCrtcNotify(mynxCrtcs[0], modeA, 0, 0, RR_Rotate_0, NULL, 1, &a);
+    if (b && mynxSecondW && mynxSecondH) {
+        modeB = lorieCvt(mynxSecondW, mynxSecondH, pvfb->root.framerate);
+        RROutputSetConnection(b, RR_Connected);
+        RROutputSetModes(b, &modeB, 1, 0);
+        RRCrtcNotify(mynxCrtcs[1], modeB, width, 0, RR_Rotate_0, NULL, 1, &b);
+        width += modeB->mode.width;
+        height = max(height, modeB->mode.height);
+    } else if (b) {
+        RRCrtcNotify(mynxCrtcs[1], NULL, 0, 0, RR_Rotate_0, NULL, 0, NULL);
+        RROutputSetModes(b, NULL, 0, 0);
+        RROutputSetConnection(b, RR_Disconnected);
+    }
+    mynxNoteCrtcs();
+    RRScreenSizeSet(pScreen, width, height, ((double) width) * 25.4 / monitorResolution, ((double) height) * 25.4 / monitorResolution);
+    RRTellChanged(pScreen);
+}
+
+void mynxSecondMonitor(int width, int height) {
+    dprintf(2, "mynx: second monitor %dx%d\n", width, height);
+    if (width == mynxSecondW && height == mynxSecondH)
+        return;
+    mynxSecondW = width;
+    mynxSecondH = height;
+    mynxApplyMonitors();
+}
