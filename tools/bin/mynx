#!/usr/bin/env python3
"""mynx: control the app from Debian. `mynx help` lists the commands."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

if __name__ == "__main__":
    try:
        from mynx.cli import main

        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        # Ctrl+C: requests already cancelled themselves, nothing to say.
        sys.exit(130)
