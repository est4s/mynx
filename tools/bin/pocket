#!/usr/bin/env python3
"""pocket: control the app from Debian. `pocket help` lists the commands."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

if __name__ == "__main__":
    try:
        from pocket_terminal.cli import main

        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        # Ctrl+C: requests already cancelled themselves, nothing to say.
        sys.exit(130)
