#!/usr/bin/env python3
"""pocket: control the app from Debian. `pocket help` lists the commands."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

from pocket_terminal.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
