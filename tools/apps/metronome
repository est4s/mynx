}


def big(text):
    """Text in a 5-pixel font drawn with half blocks: three rows."""
    rows = ["", "", ""]
    for i, ch in enumerate(text):
        g = FONT.get(ch, FONT[" "])
        g = g + [" " * len(g[0])]
        for r in range(3):
            top, bot = g[2 * r], g[2 * r + 1]
            for a, b in zip(top, bot):
                rows[r] += {(1, 1): "█", (1, 0): "▀", (0, 1): "▄"}.get(
                    (a == "#", b == "#"), " ")
            if i < len(text) - 1:
                rows[r] += " "
    return rows


def shade(rows, c):
    """Lighter at the top, full colour at the bottom."""
    return [fg(mix(WHITE, c, 0.45 + 0.3 * i)) + r + RESET for i, r in enumerate(rows)]


def vlen(s):
    n, i = 0, 0
    while i < len(s):
        if s[i] == "\x1b":
            i = s.index("m", i) + 1
        else:
            n += 1
            i += 1
    return n


def center(s, w):
    pad = max(0, (w - vlen(s)) // 2)
    return " " * pad + s


# ---------------------------------------------------------------- state

class State:
    def __init__(self):
        self.bpm = 100
        self.beats = 4
        self.sub = 1
        self.accent = True
        self.sound = "wood"
        self.volume = 0.8
        self.muted = False
        self.vibrate = False
        self.flash_torch = False
        self.offset = 0.0           # seconds to move the picture by
        self.load()
        self.playing = False
        self.taps = []
        self.claps = None
        self.since = None           # when it started, for the clock
        self.angle = 0.0            # pendulum, shown
        self.flash = None, 0.0      # message, until
        self.seen = -1              # last event step acted on

    KEYS = ("bpm", "beats", "sub", "accent", "sound", "volume", "vibrate",
            "flash_torch", "offset")

    def load(self):
        try:
            with open(STATE) as f:
                d = json.load(f)
            for k in self.KEYS:
                if k in d:
                    setattr(self, k, type(getattr(self, k))(d[k]))
        except (OSError, ValueError, TypeError):
            pass
        self.bpm = max(BPM_MIN, min(BPM_MAX, self.bpm))
        self.beats = max(1, min(12, self.beats))
        self.sub = self.sub if self.sub in SUBS else 1
        self.sound = self.sound if self.sound in SOUNDS else "wood"

    def save(self):
        try:
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            with open(STATE, "w") as f:
                json.dump({k: getattr(self, k) for k in self.KEYS}, f)
        except OSError:
            pass

    def say(self, msg):
        self.flash = msg, time.time() + 1.5


# ---------------------------------------------------------------- drawing

def header(st, eng, cols, glow):
    dotc = mix(FAINT, HOT if glow[1] else ACCENT, glow[0]) if st.playing else MUTED
    left = f" {fg(dotc)}●{RESET} {fg(ACCENT)}{BOLD}METRONOME{RESET}"
    chips = []
    if eng.error:
        chips.append((HOT, "NO SOUND"))
    if st.muted:
        chips.append((AMBER, "MUTE"))
    if st.flash_torch:
        chips.append((AMBER, "FLASH"))
    if st.vibrate:
        chips.append((MUTED, "VIB"))
    chips.append((MUTED, f"{st.volume * 100:.0f}%"))
    chips.append((INK, st.sound.upper()))
    msg, until = st.flash

    def build():
        r = "  ".join(fg(c) + t + RESET for c, t in chips) + " "
        if msg and time.time() < until:
            r = fg(AMBER) + msg + RESET + "  " + r
        return r

    right = build()
    while cols - vlen(left) - vlen(right) < 1 and chips:
        chips.pop(0)
        right = build()
    return left + " " * max(1, cols - vlen(left) - vlen(right)) + right


def footer(cols):
    keys = [("␣", "start"), ("t", "tap"), ("c", "clap"), ("b", "beats"),
            ("d", "sub"), ("s", "sound"), ("q", "quit")]
    parts = [f"{fg(ACCENT)}{k}{RESET} {fg(MUTED)}{v}{RESET}" for k, v in keys]
    s = "  ".join(parts)
    if vlen(s) > cols:
        s = " ".join(f"{fg(ACCENT)}{k}{RESET}{fg(MUTED)}{v[:3]}{RESET}" for k, v in keys)
    return center(s, cols)


def draw_pendulum(st, cw, ch, angle, glow, side):
    """A wind-up metronome: a body, a scale and the rod with its weight,
    which sits lower the faster it goes, as on the real thing."""
    cv = Canvas(cw, ch)
    W, H = cv.W, cv.H
    cx = (W - 1) / 2
    L = min(H - 4, W * 0.62)
    base = H - 1
    px, py = cx, base - L * 0.14              # pivot
    amp = math.radians(30)
    hot = HOT if glow[1] else ACCENT

    # body: a tall trapezoid, outline only, a little lighter on one side
    bw, tw, bh = L * 0.62, L * 0.2, L * 0.9
    cv.line(cx - bw / 2, base, cx + bw / 2, base, RING, 1)
    cv.line(cx - bw / 2, base, cx - tw / 2, base - bh, mix(RING, ACCENT, 0.3), 1)
    cv.line(cx + bw / 2, base, cx + tw / 2, base - bh, dim(RING, 0.7), 1)
    cv.line(cx - tw / 2, base - bh, cx + tw / 2, base - bh, RING, 1)
    cv.line(cx - bw / 2 + 2, base - 2, cx + bw / 2 - 2, base - 2, FAINT, 0, every=2)

    # scale behind the rod, with the end the rod reached glowing
    R = L * 0.97
    for k in range(-8, 9):
        a = amp * k / 8
        r0 = R - (3 if k % 4 == 0 else 1.5)
        c = FAINT if k % 4 else RING
        if abs(k) == 8 and st.playing and (k > 0) == (side > 0):
            c = mix(RING, hot, glow[0])
        cv.line(px + r0 * math.sin(a), py - r0 * math.cos(a),
                px + R * math.sin(a), py - R * math.cos(a), c, 2)

    # rod, with fading ghosts behind it for motion
    def rod(a, c, p):
        cv.line(px, py, px + L * 0.92 * math.sin(a), py - L * 0.92 * math.cos(a), c, p)

    if st.playing:
        for i, g in enumerate((0.05, 0.1, 0.15)):
            if st.frac - g >= 0:
                rod(-side * amp * math.cos(math.pi * (st.frac - g)), dim(RING, 0.7 - i * 0.2), 3)
    rod(angle, mix(INK, hot, glow[0] * 0.6), 5)

    # the sliding weight
    pos = 0.32 + 0.55 * (1 - (st.bpm - BPM_MIN) / (BPM_MAX - BPM_MIN))
    wx, wy = px + L * pos * math.sin(angle), py - L * pos * math.cos(angle)
    s = max(2.5, L * 0.07)
    ca, sa = math.cos(angle), math.sin(angle)

    def pt(u, v):          # u across the rod, v along it
        return wx + u * ca + v * sa, wy + u * sa - v * ca

    wc = mix(mix(INK, ACCENT, 0.4), WHITE if not glow[1] else HOT, glow[0])
    cv.quad([pt(-s * 1.2, -s * 0.8), pt(s * 1.2, -s * 0.8), pt(s * 0.8, s * 0.8),
             pt(-s * 0.8, s * 0.8)], wc, 6)
    cv.disc(px, py, max(1.5, L * 0.025), ACCENT, 7)
    return cv.rows()


def beat_boxes(st, cols, cur_beat, cur_part, glow):
    n = st.beats
    bw = max(1, min(7, (cols - 2) // n - 1))
    top, bot, subs = [], [], []
    for b in range(n):
        accent = b == 0 and st.accent
        base = HOT if accent else ACCENT
        if st.playing and b == cur_beat:
            c = mix(base, WHITE, glow[0] * 0.5)
        elif st.playing and cur_beat is not None and b < cur_beat:
            c = dim(base, 0.35)
        else:
            c = dim(base, 0.2)
        top.append(fg(c) + "█" * bw + RESET)
        bot.append(fg(dim(c, 0.6)) + "▀" * bw + RESET)
        marks = ""
        for p in range(st.sub):
            lit = st.playing and b == cur_beat and p <= cur_part
            marks += "•" if lit else "·"
        mc = mix(MUTED, INK, 1.0) if st.playing and b == cur_beat else FAINT
        cell = marks[:bw].center(bw) if st.sub > 1 else " " * bw
        subs.append(fg(mc) + cell + RESET)
    return [center(" ".join(r), cols) for r in (top, bot, subs)]


def clap_panel(st, cols, rows):
    cl = st.claps
    out = [""] * max(0, rows // 2 - 4)
    out.append(center(f"{fg(AMBER)}{BOLD}CLAP THE BEAT{RESET}", cols))
    out.append(center(f"{fg(MUTED)}four or more claps; it starts on your beat{RESET}", cols))
    out.append("")
    n = len(cl.times)
    dots = " ".join(fg(MINT) + "●" + RESET for _ in range(min(n, 12)))
    dots += (" " if n else "") + " ".join(fg(FAINT) + "○" + RESET for _ in range(max(0, 4 - n)))
    out.append(center(dots, cols))
    out.append("")
    w = min(40, cols - 8)
    lvl = 0 if cl.level <= 1 else max(0.0, min(1.0, (20 * math.log10(cl.level) - 40) / 50))
    k = int(lvl * w)
    bar = "".join(fg(mix(MINT, HOT, i / w)) + "▮" for i in range(k)) + fg(FAINT) + "▯" * (w - k)
    out.append(center(f"{fg(MUTED)}mic {RESET}" + bar + RESET, cols))
    est = cl.tempo()
    out.append("")
    if cl.message:
        out.append(center(fg(AMBER) + cl.message + RESET, cols))
    elif est:
        out.append(center(f"{fg(INK)}≈ {est:.0f} bpm{RESET}", cols))
    return out[:rows] + [""] * max(0, rows - len(out))


def frame(st, eng, cols, rows, view):
    cur_beat, cur_part, glow, side, angle = view
    out = [header(st, eng, cols, glow), fg(FAINT) + "─" * cols + RESET]
    boxes = beat_boxes(st, cols, cur_beat, cur_part, glow)
    digits = shade(big(f"{st.bpm:>3d}"), HOT if glow[1] and glow[0] > 0.5 else ACCENT)
    label = [f"{fg(MUTED)}BPM{RESET}", "", ""]
    read = [center(d + "  " + l + " " * (3 - vlen(l)), cols) for d, l in zip(digits, label)]
    elapsed = ""
    if st.playing and st.since:
        e = int(time.monotonic() - st.since)
        elapsed = f" {fg(FAINT)}·{RESET} {fg(MUTED)}{e // 60:02d}:{e % 60:02d}{RESET}"
    bar_no = ""
    if st.playing and st.bar is not None:
        bar_no = f" {fg(FAINT)}·{RESET} {fg(MUTED)}bar {st.bar + 1}{RESET}"
    info = (f"{fg(INK)}{tempo_name(st.bpm)}{RESET} {fg(FAINT)}·{RESET} "
            f"{fg(INK)}{st.beats}/4{RESET} {fg(FAINT)}·{RESET} "
            f"{fg(MUTED)}{SUB_MARK[st.sub]} {SUBS[st.sub]}{RESET}" + bar_no + elapsed)
    if eng.error and not st.playing:
        info = fg(HOT) + eng.error + RESET
    fixed = len(out) + len(boxes) + 1 + len(read) + 1 + 1 + 1
    area = rows - fixed
    if st.claps:
        out += clap_panel(st, cols, max(0, area))
    elif area >= 6:
        out += draw_pendulum(st, cols, area, angle, glow, side)
    else:
        out += [""] * max(0, area)
    out += boxes + [""] + read + [center(info, cols)]
    out += [""] * (rows - 1 - len(out))
    out.append(footer(cols))
    return out[:rows]


# ---------------------------------------------------------------- the beat, as seen

def current(st, eng, sig_torch, sig_vib):
    """Where the beat is now: (beat, part, (glow, accented), side, angle).
    Also fires the torch and the vibration as each beat comes due."""
    now = time.monotonic()
    with eng.lock:
        evs = [(eng.heard(e[0]),) + e[1:] for e in eng.events]
    last = last_beat = nxt = None
    for e in evs:
        if e[0] <= now:
            last = e
            if e[3] == 0:
                last_beat = e
        elif nxt is None:
            nxt = e
    target = 0.0
    glow, accented, side = 0.0, False, 1
    cur_beat = cur_part = None
    st.bar = None
    per_beat = 60.0 / st.bpm
    if st.playing and last_beat:
        _, step, beat, _, beat_no = last_beat
        frac = min(1.0, (now - last_beat[0]) / per_beat)
        side = 1 if beat_no % 2 else -1
        target = -side * math.radians(30) * math.cos(math.pi * frac)
        st.frac = frac
        cur_beat, cur_part = beat, last[3]
        st.bar = beat_no // st.beats
        glow = math.exp(-(now - last[0]) / (0.09 if last[3] else 0.16))
        if last[3]:
            glow *= 0.45
        accented = beat == 0 and st.accent and last[3] == 0
        if last[1] != st.seen:
            st.seen = last[1]
            if last[3] == 0:
                if st.flash_torch and sig_torch:
                    sig_torch.send("torch", "on", "100" if accented else "35")
                if st.vibrate and sig_vib:
                    sig_vib.send("vibrate", "60" if accented else "25")
        if st.flash_torch and sig_torch and now - last[0] > 0.07 and st.torch_on != last[1]:
            st.torch_on = last[1]
            sig_torch.send("torch", "off")
        st.angle = target
    else:
        st.angle *= 0.85
    return cur_beat, cur_part, (glow, accented), side, st.angle, nxt


# ---------------------------------------------------------------- keys

def tap(st, eng, when):
    if st.taps and when - st.taps[-1] > 2.0:
        st.taps = []
    st.taps = (st.taps + [when])[-8:]
    if len(st.taps) >= 2:
        iv = sorted(np.diff(st.taps))
        bpm = int(round(60.0 / iv[len(iv) // 2]))
        with eng.lock:
            st.bpm = max(BPM_MIN, min(BPM_MAX, bpm))
        st.say(f"tap {len(st.taps)}")
        if st.playing and len(st.taps) >= 3:
            eng.align(when + 60.0 / st.bpm)
        st.save()
    else:
        st.say("tap again")


def set_bpm(st, eng, bpm):
    with eng.lock:
        st.bpm = max(BPM_MIN, min(BPM_MAX, int(bpm)))
    st.save()


def start_stop(st, eng, sig_torch):
    st.playing = not st.playing
    if st.playing:
        st.since = time.monotonic()
        eng.start_beat()
    else:
        eng.stop_beat()
        if st.flash_torch and sig_torch:
            sig_torch.send("torch", "off")


def handle(st, eng, k, sig_torch):
    """One key (or escape sequence); False to quit."""
    if st.claps:
        if k in ("c", "C", "\x1b", "q", " "):
            st.claps.close()
            st.claps = None
            st.say("clap cancelled")
        return k not in ("q", "Q", "\x03")
    if k in ("q", "Q", "\x03", "\x1b"):
        return False
    with eng.lock:
        if k == " ":
            pass
        elif k in ("+", "=", "\x1b[A"):
            st.bpm = min(BPM_MAX, st.bpm + 1)
        elif k in ("-", "_", "\x1b[B"):
            st.bpm = max(BPM_MIN, st.bpm - 1)
        elif k == "\x1b[C":
            st.bpm = min(BPM_MAX, st.bpm + 5)
        elif k == "\x1b[D":
            st.bpm = max(BPM_MIN, st.bpm - 5)
        elif k == "\x1b[5~":
            st.bpm = min(BPM_MAX, st.bpm + 10)
        elif k == "\x1b[6~":
            st.bpm = max(BPM_MIN, st.bpm - 10)
        elif k == "b":
            st.beats = st.beats % 12 + 1
            st.say(f"{st.beats} beats")
        elif k == "B":
            st.beats = (st.beats - 2) % 12 + 1
            st.say(f"{st.beats} beats")
        elif k in "dD":
            order = [1, 2, 3, 4]
            st.sub = order[(order.index(st.sub) + (1 if k == "d" else -1)) % 4]
            st.say(SUBS[st.sub])
        elif k in "aA":
            st.accent = not st.accent
            st.say("accent " + ("on" if st.accent else "off"))
        elif k in "sS":
            st.sound = SOUNDS[(SOUNDS.index(st.sound) + (1 if k == "s" else -1)) % len(SOUNDS)]
            st.say(st.sound)
        elif k == "]":
            st.volume = min(1.0, round(st.volume + 0.1, 1))
        elif k == "[":
            st.volume = max(0.1, round(st.volume - 0.1, 1))
        elif k in "mM":
            st.muted = not st.muted
        elif k in "vV":
            st.vibrate = not st.vibrate
            st.say("vibrate " + ("on" if st.vibrate else "off"))
        elif k in "fF":
            st.flash_torch = not st.flash_torch
            st.say("torch flash " + ("on" if st.flash_torch else "off"))
        elif k in ",<":
            st.offset = round(st.offset - 0.01, 2)
            st.say(f"picture {st.offset * 1000:+.0f} ms")
        elif k in ".>":
            st.offset = round(st.offset + 0.01, 2)
            st.say(f"picture {st.offset * 1000:+.0f} ms")
    if k == " ":
        start_stop(st, eng, sig_torch)
    elif k in ("t", "T", "\r", "\n"):
        tap(st, eng, time.monotonic())
    elif k in ("c", "C"):
        if st.playing:
            start_stop(st, eng, sig_torch)
        try:
            st.claps = Claps()
        except Exception as e:
            st.say(f"no microphone: {e}")
    elif k in ("f", "F") and not st.flash_torch and sig_torch:
        sig_torch.send("torch", "off")
    st.save()
    return True


def split_keys(data):
    """Bytes from the terminal into keys, keeping escape sequences whole."""
    keys, i = [], 0
    while i < len(data):
        if data[i] == "\x1b" and i + 1 < len(data) and data[i + 1] in "[O":
            j = i + 2
            while j < len(data) and not (data[j].isalpha() or data[j] == "~"):
                j += 1
            keys.append("\x1b[" + data[i + 2:j + 1])
            i = j + 1
        else:
            keys.append(data[i])
            i += 1
    return keys


# ---------------------------------------------------------------- main loop

def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(__doc__.strip())
        return 0
    if not sys.stdin.isatty():
        print("metronome: needs a terminal", file=sys.stderr)
        return 2
    global np
    np = needs.numpy("metronome")
    st = State()
    st.frac, st.bar, st.torch_on = 0.0, None, None
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if args:
        try:
            st.bpm = max(BPM_MIN, min(BPM_MAX, int(args[0])))
        except ValueError:
            print(__doc__.strip())
            return 2
    eng = Engine(st)
    eng.start()
    sig_torch = sig_vib = None
    if request and os.environ.get("MYNX_REQUESTS"):
        sig_torch, sig_vib = Signal(), Signal()
        sig_torch.start()
        sig_vib.start()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    w = sys.stdout.write
    resized = [True]
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    last_draw = 0.0
    try:
        tty.setcbreak(fd)
        w("\x1b[?1049h\x1b[?25l\x1b]0;metronome\a")
        while True:
            *view, nxt = current(st, eng, sig_torch, sig_vib)
            now = time.monotonic()
            wait = 1 / 40 if st.playing or abs(st.angle) > 0.001 else 0.25
            if nxt:
                wait = max(0.0, min(wait, nxt[0] - now))
            if st.claps:
                wait = 1 / 30
            fds = [fd]
            if st.claps and st.claps.fileno() is not None:
                fds.append(st.claps.fileno())
            r, _, _ = select.select(fds, [], [], wait)
            if fd in r:
                data = os.read(fd, 64).decode(errors="ignore")
                for k in split_keys(data):
                    if not handle(st, eng, k, sig_torch):
                        return 0
            if st.claps:
                try:
                    st.claps.poll()
                except Exception as e:
                    st.claps.close()
                    st.claps = None
                    st.say(f"mic: {e}")
                else:
                    cl = st.claps
                    now = time.monotonic()
                    est = cl.tempo()
                    if est and len(cl.times) >= 4 and now - cl.times[-1] > max(1.2, 1.6 * 60 / est):
                        set_bpm(st, eng, round(est))
                        beat = 60.0 / st.bpm
                        last = cl.times[-1]
                        cl.close()
                        st.claps = None
                        start_stop(st, eng, sig_torch)
                        nxt_beat = last + beat
                        while nxt_beat < now + 0.05:
                            nxt_beat += beat
                        eng.align(nxt_beat)
                        st.say(f"{st.bpm} bpm from your claps")
                    elif cl.times and len(cl.times) < 4 and now - cl.times[-1] > 3:
                        cl.times = []
            now = time.monotonic()
            if now - last_draw >= 1 / 45 or resized[0] or fd in r:
                *view, _ = current(st, eng, sig_torch, sig_vib)
                cols, rows = shutil.get_terminal_size()
                if resized[0]:
                    w("\x1b[2J")
                    resized[0] = False
                lines = frame(st, eng, cols, rows, view)
                w("\x1b[H" + "\x1b[K\n".join(lines) + "\x1b[K\x1b[J")
                sys.stdout.flush()
                last_draw = now
    except KeyboardInterrupt:
        return 0
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        w("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        st.save()
        if st.claps:
            st.claps.close()
        eng.close()
        if st.flash_torch and sig_torch:
            try:
                request("torch", "off")
            except Exception:
                pass


if __name__ == "__main__":
    sys.exit(main())
