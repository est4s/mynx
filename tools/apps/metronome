def fg(c):
    return f"{ESC}38;2;{c[0]};{c[1]};{c[2]}m"


def mix(a, b, t):
    t = max(0.0, min(1.0, t))
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def dim(c, k):
    return tuple(int(v * k) for v in c)


