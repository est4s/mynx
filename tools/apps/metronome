def tempo_name(bpm):
    for top, name in ((40, "Grave"), (60, "Largo"), (66, "Larghetto"), (76, "Adagio"),
                      (108, "Andante"), (120, "Moderato"), (156, "Allegro"),
                      (176, "Vivace"), (200, "Presto")):
        if bpm < top:
            return name
    return "Prestissimo"


# ---------------------------------------------------------------- sounds

def make_sounds():
    """Each sound as float arrays for the accented beat, a beat and a subdivision."""
    def t(dur):
        return np.arange(int(RATE * dur)) / RATE

    def wood(f, amp):
        x = t(0.09)
        s = np.sin(2 * np.pi * f * x) + 0.35 * np.sin(2 * np.pi * f * 2.76 * x)
        s *= np.exp(-x / 0.016)
        s[:96] += np.random.default_rng(1).normal(0, 0.4, 96) * np.linspace(1, 0, 96)
        return s * amp * 0.75

    def click(f, amp):
        x = t(0.035)
        n = np.diff(np.random.default_rng(2).normal(0, 1, len(x) + 1))
        s = 0.5 * n * np.exp(-x / 0.003) + np.sin(2 * np.pi * f * x) * np.exp(-x / 0.007)
        return s * amp * 0.8

    def beep(f, amp):
        x = t(0.06)
        env = np.minimum(1, x / 0.002) * np.minimum(1, (x[-1] - x) / 0.012)
        return np.sin(2 * np.pi * f * x) * env * amp * 0.6

    def bell(f, amp):
        x = t(0.28)
        s = sum(np.sign(np.sin(2 * np.pi * f * k * x)) * w
                for k, w in ((1.0, 0.6), (1.48, 0.4)))
        s = np.convolve(s, np.ones(6) / 6, "same")     # take the edge off
        return s * np.exp(-x / 0.07) * np.minimum(1, x / 0.001) * amp * 0.35

    base = {"wood": (wood, 1000), "click": (click, 2600), "beep": (beep, 880),
            "bell": (bell, 560)}
    out = {}
    for name, (fn, f) in base.items():
        out[name] = {"accent": fn(f * 1.5, 1.0), "beat": fn(f, 0.7),
                     "sub": fn(f * 0.75, 0.35)}
    return out


# ---------------------------------------------------------------- the clock and sound

class Engine(threading.Thread):
    """Writes the click track to pacat, paced by the wall clock, and reports
    when each click will be heard. Without a sound device it keeps the same
    clock silently, so the picture still runs."""

    def __init__(self, st):
        super().__init__(daemon=True)
        self.st = st
        self.lock = threading.Lock()
        self.events = deque(maxlen=64)   # (sample, step, beat, sub, beat no.)
        self.sounds = make_sounds()
        self.running = False
        self.restart = False
        self.align_at = None
        self.stopping = False
        self.error = None
        self.proc = None
        self.base = time.monotonic() + 0.1
        self.retry = 0.0
        self.open()

    def open(self):
        """Start pacat; the sound device can restart under us, so it's
        called again every couple of seconds while sound is missing."""
        self.retry = time.monotonic() + 2
        if not shutil.which("pacat"):
            self.error = "no sound: pacat is missing"
            return
        try:
            self.proc = subprocess.Popen(
                ["pacat", "--raw", "--format=s16le", f"--rate={RATE}", "--channels=1",
                 "--latency-msec=250", "--client-name=metronome"],
                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL)
            fcntl.fcntl(self.proc.stdin.fileno(), 1031, 4096)   # F_SETPIPE_SZ
            self.error = None
        except OSError as e:
            self.proc, self.error = None, f"no sound: {e}"

    def drop(self):
        proc, self.proc = self.proc, None
        if proc:
            try:
                proc.kill()
                proc.stdin.close()
            except (OSError, ValueError):
                pass

    def start_beat(self):
        with self.lock:
            self.running, self.restart = True, True

    def stop_beat(self):
        with self.lock:
            self.running = False
            self.events.clear()

    def align(self, when):
        """Put the next beat at wall time `when` (when it should be heard)."""
        with self.lock:
            self.align_at = when

    def heard(self, pos):
        """The wall time sample `pos` comes out of the speaker."""
        return self.base + pos / RATE + self.st.offset

    def run(self):
        written = 0
        step, next_step = 0, 0.0
        tail = np.zeros(0, np.float32)
        seen = deque()
        while not self.stopping:
            if not self.proc and time.monotonic() > self.retry:
                self.open()
                seen.clear()
            if not self.proc:
                # no sound: keep the same clock against the wall
                if written / RATE + self.base - LEAD > time.monotonic():
                    time.sleep(0.005)
                    continue
            st = self.st
            acc = np.zeros(max(BLOCK, len(tail)), np.float32)
            acc[:len(tail)] += tail
            with self.lock:
                bpm, sub, beats = st.bpm, st.sub, st.beats
                per_step = RATE * 60.0 / bpm / sub
                if self.restart:
                    self.restart = False
                    step, next_step = 0, written + RATE * 0.03
                if self.align_at is not None and self.running:
                    s = (self.align_at - st.offset - self.base) * RATE
                    while s < written:
                        s += per_step * sub
                    step = -(-step // sub) * sub       # up to the next beat
                    next_step = s
                    self.align_at = None
                while self.running and next_step < written + BLOCK:
                    beat, part = (step // sub) % beats, step % sub
                    kind = "sub" if part else ("accent" if beat == 0 and st.accent
                                               else "beat")
                    snd = self.sounds[st.sound][kind]
                    off = max(0, int(next_step - written))
                    if off + len(snd) > len(acc):
                        acc = np.concatenate([acc, np.zeros(off + len(snd) - len(acc),
                                                            np.float32)])
                    acc[off:off + len(snd)] += snd
                    self.events.append((next_step, step, beat, part, step // sub))
                    step += 1
                    next_step += per_step
                vol = 0.0 if st.muted else st.volume
            block, tail = acc[:BLOCK], acc[BLOCK:]
            written += BLOCK
            if self.proc:
                pcm = np.clip(block * vol, -1, 1)
                try:
                    self.proc.stdin.write((pcm * 32767).astype("<i2").tobytes())
                    self.proc.stdin.flush()
                except (OSError, ValueError):
                    self.drop()
                    self.error = "sound stopped (is the sound device on?)"
                    continue
                # A write returns once the queue to the speaker has room, so
                # the sample just written comes out a full queue later. Writes
                # that return sooner (the queue had room) only ever look early,
                # so take the latest over the last two seconds.
                now = time.monotonic()
                seen.append((now, now - written / RATE + QUEUE))
                while seen[0][0] < now - 2:
                    seen.popleft()
                self.base = max(o for _, o in seen)

    def close(self):
        self.stopping = True
        self.drop()


# ---------------------------------------------------------------- torch and vibration

class Signal(threading.Thread):
    """Sends the latest wanted request to the app; ones that are passed over
    while a request is out are skipped, so it never falls behind the beat."""

    def __init__(self):
        super().__init__(daemon=True)
        self.want = None
        self.cond = threading.Condition()

    def send(self, *args):
        with self.cond:
            self.want = args
            self.cond.notify()

    def run(self):
        while True:
            with self.cond:
                while self.want is None:
                    self.cond.wait()
                args, self.want = self.want, None
            try:
                request(*args)
            except Exception:
                time.sleep(0.3)


# ---------------------------------------------------------------- clap detection

class Claps:
    """Listens to the microphone (mic.py) for claps and works out their tempo."""

    def __init__(self):
        from mic import Mic
        self.mic = Mic(RATE)
        self.mic.start()
        self.times = []
        self.floor = 300.0
        self.prev = 0.0
        self.level = 0.0
        self.rest = np.zeros(0, np.float32)
        self.message = None

    def fileno(self):
        return self.mic.fileno()

    def poll(self):
        """Read new audio; returns the new claps' times."""
        got = self.mic.read()
        self.message = self.mic.status
        if not len(got):
            return []
        now = time.monotonic()
        x = np.concatenate([self.rest, np.frombuffer(got, np.int16).astype(np.float32)])
        n = len(x) // BLOCK
        self.rest = x[n * BLOCK:]
        new = []
        for i in range(n):
            b = x[i * BLOCK:(i + 1) * BLOCK]
            rms = float(np.sqrt(np.mean(b * b)))
            when = now - (n - i) * BLOCK / RATE
            thr = max(1200.0, self.floor * 6)
            if rms > thr and self.prev < thr and (not self.times or when - self.times[-1] > 0.12):
                if self.times and when - self.times[-1] > 2.5:
                    self.times = []
                self.times.append(when)
                new.append(when)
            elif rms < self.floor * 3:
                self.floor += (rms - self.floor) * 0.05
            self.prev = rms
            self.level = max(rms, self.level * 0.85)
        return new

    def tempo(self):
        if len(self.times) < 2:
            return None
        iv = sorted(np.diff(self.times[-8:]))
        return 60.0 / iv[len(iv) // 2]

    def close(self):
        self.mic.close()


# ---------------------------------------------------------------- braille canvas

BITS = ((0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80))


class Canvas:
    """Braille dots (2x4 per cell), one colour per cell: highest priority wins."""

    def __init__(self, w, h):
        self.w, self.h = w, h
        self.W, self.H = w * 2, h * 4
        self.dots = [[0] * w for _ in range(h)]
        self.col = [[None] * w for _ in range(h)]
        self.pri = [[-1] * w for _ in range(h)]

    def dot(self, x, y, c, p=0):
        xi, yi = int(round(x)), int(round(y))
        if 0 <= xi < self.W and 0 <= yi < self.H:
            cx, cy = xi >> 1, yi >> 2
            self.dots[cy][cx] |= BITS[yi & 3][xi & 1]
            if p >= self.pri[cy][cx]:
                self.pri[cy][cx] = p
                self.col[cy][cx] = c

    def line(self, x0, y0, x1, y1, c, p=0, every=1):
        n = max(1, int(max(abs(x1 - x0), abs(y1 - y0))))
        for i in range(0, n + 1, every):
            t = i / n
            self.dot(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, c, p)

    def disc(self, cx, cy, r, c, p=0):
        for yi in range(int(cy - r - 1), int(cy + r + 2)):
            for xi in range(int(cx - r - 1), int(cx + r + 2)):
                if (xi - cx) ** 2 + (yi - cy) ** 2 <= r * r:
                    self.dot(xi, yi, c, p)

    def quad(self, pts, c, p=0):
        """A filled convex polygon."""
        xs, ys = [q[0] for q in pts], [q[1] for q in pts]
        for yi in range(int(min(ys)) - 1, int(max(ys)) + 2):
            for xi in range(int(min(xs)) - 1, int(max(xs)) + 2):
                sgn = 0
                for (ax, ay), (bx, by) in zip(pts, pts[1:] + pts[:1]):
                    d = (bx - ax) * (yi - ay) - (by - ay) * (xi - ax)
                    if d:
                        if sgn and (d > 0) != (sgn > 0):
                            break
                        sgn = d
                else:
                    self.dot(xi, yi, c, p)

    def rows(self):
        out = []
        for r in range(self.h):
            line, cur = [], None
            for c in range(self.w):
                if self.dots[r][c]:
                    ch, colr = chr(0x2800 + self.dots[r][c]), self.col[r][c]
                else:
                    ch, colr = " ", None
                if colr != cur and ch != " ":
                    line.append(fg(colr))
                    cur = colr
                line.append(ch)
            out.append("".join(line) + RESET)
        return out


