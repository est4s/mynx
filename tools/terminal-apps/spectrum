#!/usr/bin/env python3
# label: Spectrum
"""spectrum: a live sound spectrum analyzer for the phone's microphone.

It streams the microphone from the app's sound device (PulseAudio, through
`parec`) and draws the frequencies it hears, about 30 times a second, with
the loudest note named at the top.

Usage: spectrum [--demo]     (--demo plays a made-up signal instead of the mic)

Keys: q quit, m bars/waterfall, w bar width, l log/linear frequency,
p peak markers, + and - sensitivity, r reset, space pause.
"""
import array
import cmath
import math
import os
import random
import select
import shutil
import sys
import termios
import time
import tty

from mic import Mic

RATE = 48000                  # the sound device records at 48 kHz
N = 4096                      # FFT size: 11.7 Hz per bin, 85 ms window
FMIN, FMAX = 30.0, 20000.0
FPS = 30
TOP, RANGE = -10.0, 80.0      # dBFS at the top of the plot, dB shown
FALL = 1.2                    # bars fall this much of the height per second
PEAK_HOLD, PEAK_FALL = 0.8, 0.5
AXIS = 4                      # columns for the dB labels

BARS = [(0.0, (56, 189, 248)), (0.35, (52, 211, 153)), (0.6, (250, 204, 21)),
        (0.8, (251, 146, 60)), (1.0, (244, 63, 94))]
HEAT = [(0.0, (12, 12, 28)), (0.25, (70, 25, 120)), (0.5, (190, 45, 120)),
        (0.75, (250, 140, 40)), (1.0, (255, 245, 190))]
DIM, FAINT, TEXT, PEAK = (110, 110, 135), (60, 60, 80), (220, 220, 235), (240, 240, 255)
EIGHTHS = " ▁▂▃▄▅▆▇█"
NOTES = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"]
TICKS = [(31.5, "31"), (50, "50"), (63, "63"), (100, "100"), (125, "125"),
         (200, "200"), (250, "250"), (500, "500"), (1000, "1k"), (2000, "2k"),
         (4000, "4k"), (5000, "5k"), (8000, "8k"), (10000, "10k"),
         (16000, "16k"), (20000, "20k")]


def ramp(stops, t):
    t = min(1.0, max(0.0, t))
    for (t0, c0), (t1, c1) in zip(stops, stops[1:]):
        if t <= t1:
            f = (t - t0) / (t1 - t0)
            return tuple(round(a + (b - a) * f) for a, b in zip(c0, c1))
    return stops[-1][1]


def make_fft(n):
    """Recursive radix-2 FFT on lists; fast enough in plain Python."""
    tw = {}
    m = n
    while m > 1:
        tw[m] = [cmath.exp(-2j * math.pi * k / m) for k in range(m // 2)]
        m //= 2

    def fft(x):
        if len(x) == 2:
            return [x[0] + x[1], x[0] - x[1]]
        even, odd = fft(x[0::2]), fft(x[1::2])
        t = [w * o for w, o in zip(tw[len(x)], odd)]
        return [e + u for e, u in zip(even, t)] + [e - u for e, u in zip(even, t)]
    return fft


def note(freq):
    n = 12 * math.log2(freq / 440.0) + 69
    k = round(n)
    return f"{NOTES[k % 12]}{k // 12 - 1}", round((n - k) * 100)


class Demo:
    """A gliding chord over a little noise, for trying it without a mic."""

    def __init__(self):
        self.t0 = self.last = time.monotonic()
        self.n = 0

    def start(self):
        pass

    def read(self):
        now = time.monotonic()
        count = int((now - self.t0) * RATE) - self.n
        out = array.array("h")
        for _ in range(count):
            t = self.n / RATE
            root = 110 * 2 ** (2 * (0.5 + 0.5 * math.sin(t * 0.4)))
            v = (0.25 * math.sin(2 * math.pi * root * t)
                 + 0.12 * math.sin(2 * math.pi * root * 1.5 * t)
                 + 0.06 * math.sin(2 * math.pi * root * 4 * t)
                 + 0.03 * math.sin(2 * math.pi * 6000 * t) * (t % 2 < 1)
                 + random.gauss(0, 0.004))
            out.append(max(-32767, min(32767, int(v * 32767))))
            self.n += 1
        return out

    def close(self):
        pass


class Analyzer:
    def __init__(self):
        self.fft = make_fft(N)
        self.window = [0.5 - 0.5 * math.cos(2 * math.pi * i / (N - 1)) for i in range(N)]
        # amplitude of a full-scale sine -> 0 dBFS
        self.scale = 2.0 / sum(self.window) / 32768.0
        self.buf = array.array("h", bytes(2 * N))
        self.mode = "bars"
        self.width = 2
        self.log = True
        self.peaks_on = True
        self.paused = False
        self.notice = None          # the mic's status, shown in the footer
        self.top = TOP
        self.layout = None
        self.reset()

    def reset(self):
        self.top = TOP
        self.levels = []
        self.peaks = []
        self.held = []
        self.history = []
        self.db = [-200.0] * (N // 2)
        self.loudest = None
        self.last = time.monotonic()

    def feed(self, samples):
        if len(samples) >= N:
            self.buf = samples[-N:]
        elif samples:
            self.buf = self.buf[len(samples):] + samples

    def analyze(self):
        x = [s * w for s, w in zip(self.buf, self.window)]
        spec = self.fft(x)
        sc = self.scale
        self.db = [20 * math.log10(abs(c) * sc + 1e-12) for c in spec[:N // 2]]
        df = RATE / N
        lo, hi = int(40 / df), int(5000 / df)
        k = max(range(lo, hi), key=self.db.__getitem__)
        if self.db[k] > self.top - RANGE * 0.6:
            a, b, c = self.db[k - 1], self.db[k], self.db[k + 1]
            d = a - 2 * b + c
            p = 0.5 * (a - c) / d if d else 0.0
            self.loudest = ((k + p) * df, b)
        else:
            self.loudest = None

    def bands(self, count):
        """Frequency edges and the bins in each band, for `count` bands."""
        df = RATE / N
        fmax = min(FMAX, RATE / 2 - df)
        out = []
        for i in range(count):
            if self.log:
                f0 = FMIN * (fmax / FMIN) ** (i / count)
                f1 = FMIN * (fmax / FMIN) ** ((i + 1) / count)
            else:
                f0 = fmax * i / count
                f1 = fmax * (i + 1) / count
            b0, b1 = math.ceil(f0 / df), math.floor(f1 / df)
            if b1 >= b0:
                out.append((b0, b1 + 1, 0.0))
            else:      # narrower than a bin: interpolate at the band's middle
                pos = math.sqrt(f0 * f1) / df if self.log else (f0 + f1) / 2 / df
                out.append((int(pos), -1, pos - int(pos)))
        return out

    def freq_col(self, f, count):
        df = RATE / N
        fmax = min(FMAX, RATE / 2 - df)
        if self.log:
            return math.log(f / FMIN) / math.log(fmax / FMIN) * count
        return f / fmax * count

    def band_values(self, plan):
        db, top = self.db, self.top
        vals = []
        for b0, b1, frac in plan:
            if b1 < 0:
                v = db[b0] + (db[b0 + 1] - db[b0]) * frac
            else:
                v = max(db[b0:b1])
            vals.append(min(1.0, max(0.0, (v - (top - RANGE)) / RANGE)))
        return vals

    def step(self, count, plan):
        now = time.monotonic()
        dt, self.last = now - self.last, now
        vals = self.band_values(plan)
        if len(self.levels) != count:
            self.levels = [0.0] * count
            self.peaks = [0.0] * count
            self.held = [0.0] * count
        for i, v in enumerate(vals):
            self.levels[i] = v if v > self.levels[i] else max(v, self.levels[i] - FALL * dt)
            if self.levels[i] >= self.peaks[i]:
                self.peaks[i], self.held[i] = self.levels[i], now
            elif now - self.held[i] > PEAK_HOLD:
                self.peaks[i] = max(self.levels[i], self.peaks[i] - PEAK_FALL * dt)
        return vals

    # drawing ------------------------------------------------------------

    def render(self, cols, rows):
        h = max(3, rows - 3)
        plot_w = max(8, cols - AXIS)
        if self.mode == "waterfall":
            count, cw = plot_w, 1
        else:
            cw = self.width
            count = plot_w // cw
        key = (count, self.log, self.mode)
        if key != self.layout:
            self.layout, self.plan = key, self.bands(count)
            self.levels, self.history = [], []
        if not self.paused:
            vals = self.step(count, self.plan)
            if self.mode == "waterfall":
                self.history.insert(0, vals)
                del self.history[2 * h:]
        out = ["\x1b[H"]
        out.append(self.header(cols))
        if self.mode == "waterfall":
            out += self.waterfall(h, count)
        else:
            out += self.barplot(h, count, cw)
        out.append(self.freq_axis(count, cw, cols))
        out.append(self.footer(cols))
        return "".join(out)

    def header(self, cols):
        left = " spectrum"
        if self.loudest:
            f, db = self.loudest
            name, cents = note(f)
            hz = f"{f:.0f} Hz" if f < 1000 else f"{f / 1000:.2f} kHz"
            left += f"  ♪ {name} {cents:+d}¢  {hz}  {db:.0f} dB"
        right = ("PAUSED " if self.paused else "") + self.mode + " "
        pad = max(1, cols - len(left) - len(right))
        line = (f"\x1b[1;38;2;{TEXT[0]};{TEXT[1]};{TEXT[2]}m{left}\x1b[0m"
                f"{' ' * pad}\x1b[38;2;{DIM[0]};{DIM[1]};{DIM[2]}m{right}\x1b[0m")
        return line + "\x1b[K\r\n"

    def axis_label(self, row, h):
        """dB label for plot row `row` (0 = top), every few rows."""
        step = max(1, round(h / 6))
        if row % step:
            return " " * AXIS
        db = self.top - RANGE * row / h
        return f"\x1b[38;2;{DIM[0]};{DIM[1]};{DIM[2]}m{db:>{AXIS - 1}.0f}\x1b[0m "

    def barplot(self, h, count, cw):
        lines = []
        bar = max(1, cw - 1)
        gap = cw - bar
        units = [round(v * h * 8) for v in self.levels]
        peak_rows = [h - 1 - min(h - 1, int(p * h)) if p > 0.02 else -1 for p in self.peaks]
        for row in range(h):
            colr = ramp(BARS, 1 - (row + 0.5) / h)
            fg = f"\x1b[38;2;{colr[0]};{colr[1]};{colr[2]}m"
            pk = f"\x1b[38;2;{PEAK[0]};{PEAK[1]};{PEAK[2]}m"
            grid = (row % max(1, round(h / 6))) == 0
            line = [self.axis_label(row, h)]
            cur = None
            base = (h - 1 - row) * 8
            for i in range(count):
                u = units[i] - base
                if u >= 8:
                    ch, c = "█", fg
                elif u > 0:
                    ch, c = EIGHTHS[u], fg
                elif self.peaks_on and peak_rows[i] == row:
                    ch, c = "▔", pk
                elif grid:
                    ch, c = "·", f"\x1b[38;2;{FAINT[0]};{FAINT[1]};{FAINT[2]}m"
                else:
                    ch, c = " ", None
                if c and c != cur:
                    line.append(c)
                    cur = c
                line.append(ch * bar)
                if gap:
                    line.append(" " * gap)
            line.append("\x1b[0m\x1b[K\r\n")
            lines.append("".join(line))
        return lines

    def waterfall(self, h, count):
        lines = []
        blank = [0.0] * count
        for row in range(h):
            upper = self.history[2 * row] if 2 * row < len(self.history) else blank
            lower = self.history[2 * row + 1] if 2 * row + 1 < len(self.history) else blank
            if row == 0:
                label = f"\x1b[38;2;{DIM[0]};{DIM[1]};{DIM[2]}m{'now':>{AXIS - 1}}\x1b[0m "
            elif row == h - 1:
                secs = 2 * h / FPS
                label = f"\x1b[38;2;{DIM[0]};{DIM[1]};{DIM[2]}m{f'-{secs:.0f}s':>{AXIS - 1}}\x1b[0m "
            else:
                label = " " * AXIS
            line = [label]
            prev = None
            for a, b in zip(upper, lower):
                ca, cb = ramp(HEAT, a), ramp(HEAT, b)
                if (ca, cb) != prev:
                    line.append(f"\x1b[38;2;{ca[0]};{ca[1]};{ca[2]};48;2;{cb[0]};{cb[1]};{cb[2]}m")
                    prev = (ca, cb)
                line.append("▀")
            line.append("\x1b[0m\x1b[K\r\n")
            lines.append("".join(line))
        return lines

    def freq_axis(self, count, cw, cols):
        cells = [" "] * cols
        taken = -1
        ticks = TICKS if self.log else [(k * 1000, f"{k}k") for k in range(1, 21)]
        for f, text in ticks:
            if f < FMIN or f > min(FMAX, RATE / 2):
                continue
            col = AXIS + int(self.freq_col(f, count)) * cw
            start = col - len(text) // 2
            if start <= taken + 1 or start + len(text) > cols or start < AXIS:
                continue
            cells[start:start + len(text)] = text
            taken = start + len(text)
        return (f"\x1b[38;2;{DIM[0]};{DIM[1]};{DIM[2]}m{''.join(cells)[:cols]}"
                "\x1b[0m\x1b[K\r\n")

    def footer(self, cols):
        if self.notice:
            return f"\x1b[1;38;2;{PEAK[0]};{PEAK[1]};{PEAK[2]}m {self.notice[:cols - 1]}\x1b[0m\x1b[K"
        scale = "log" if self.log else "linear"
        text = (f" {self.top - RANGE:.0f}…{self.top:.0f} dBFS · {scale} · "
                f"peaks {'on' if self.peaks_on else 'off'} · q m w l p ± r")
        return (f"\x1b[38;2;{FAINT[0]};{FAINT[1]};{FAINT[2]}m{text[:cols]}"
                "\x1b[0m\x1b[K")


def main():
    args = sys.argv[1:]
    demo = "--demo" in args
    if [a for a in args if a != "--demo"]:
        print(__doc__.strip())
        return 0
    if not sys.stdin.isatty():
        print("spectrum needs a terminal", file=sys.stderr)
        return 2
    an = Analyzer()
    src = Demo() if demo else Mic(RATE, latency_ms=30)
    old = termios.tcgetattr(0)
    sys.stdout.write("\x1b[?1049h\x1b[?25l\x1b[2J\x1b]0;spectrum\a")
    error = None
    try:
        tty.setcbreak(0)
        src.start()
        size = None
        next_frame = time.monotonic()
        while True:
            samples = src.read()
            if not an.paused:
                an.feed(samples)
            wait = max(0.0, next_frame - time.monotonic())
            if select.select([0], [], [], wait)[0]:
                for ch in os.read(0, 64).decode(errors="ignore"):
                    if ch in "qQ\x1b":
                        return 0
                    elif ch in "mM":
                        an.mode = "waterfall" if an.mode == "bars" else "bars"
                    elif ch in "wW":
                        an.width = an.width % 3 + 1
                    elif ch in "lL":
                        an.log = not an.log
                    elif ch in "pP":
                        an.peaks_on = not an.peaks_on
                    elif ch in "+=":
                        an.top -= 5      # more sensitive: quieter sounds reach higher
                    elif ch in "-_":
                        an.top += 5
                    elif ch in "rR":
                        an.reset()
                    elif ch == " ":
                        an.paused = not an.paused
                continue
            next_frame = time.monotonic() + 1 / FPS
            if not an.paused:
                an.analyze()
            an.notice = getattr(src, "status", None)
            cols, rows = shutil.get_terminal_size()
            if (cols, rows) != size:
                size = (cols, rows)
                sys.stdout.write("\x1b[2J")
            sys.stdout.write(an.render(cols, rows))
            sys.stdout.flush()
    except KeyboardInterrupt:
        return 0
    except RuntimeError as e:
        error = f"{e} (or try `spectrum --demo`)"
        return 1
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(0, termios.TCSADRAIN, old)
        src.close()
        if error:
            print(f"spectrum: {error}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
