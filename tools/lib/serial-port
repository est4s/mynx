#!/usr/bin/env python3
"""Gives a USB serial port a pseudo-terminal in Debian, at /dev/serial/NAME.

The app runs one for each port it serves (usage: serial-port NAME
TCPPORT [FOLDER]). The port itself is the app's RFC 2217 server on
localhost TCPPORT. While a program has the terminal open, this is
connected to it: bytes go both ways, the terminal's baud rate, data
bits, parity and stop bits follow what the program sets, and DTR and
RTS are up, as on Linux, where opening a port raises them (which
resets an Arduino) and closing it drops them. While nothing has it
open, the port is free for rfc2217:// clients (esptool, PlatformIO).

Android refuses the modem-line ioctls on a pty, so programs can't set
DTR and RTS themselves: libmynx-serial.so (preloaded) asks this helper
instead, on the control socket /dev/serial/.NAME.ctl, one request per
connection: "get 0", "set BITS", "bis BITS" or "bic BITS" (TIOCM_*
bits), answered "ok BITS" with the lines as they are then.
"""
import errno
import os
import select
import signal
import socket
import sys
import termios
import time
import tty

IAC, DONT, DO, WONT, WILL, SB, SE = 255, 254, 253, 252, 251, 250, 240
COM_PORT = 44
SET_BAUDRATE, SET_DATASIZE, SET_PARITY, SET_STOPSIZE, SET_CONTROL = 1, 2, 3, 4, 5
NO_FLOW, HW_FLOW, DTR_ON, DTR_OFF, RTS_ON, RTS_OFF = 1, 3, 8, 9, 11, 12
TIOCM_DTR, TIOCM_RTS = 0x002, 0x004
# The port's inputs aren't followed: CTS, CD and DSR always read as on.
INPUTS = 0x020 | 0x040 | 0x100
# How often to look whether a program opened the terminal (Android
# allows no inotify on it), and to try the app again when it's away.
IDLE = 0.1
# How long an open too quick to see is held: with none, the 1200 baud
# touch didn't reach a Pro Micro (tried on the phone; 0.1 s did).
QUICK_OPEN = 0.2
RETRY = 1.0
# The app's server greets a client it takes at once, and closes on one it
# refuses because another client has the port (an rfc2217:// URL).
GREETING_WAIT = 1.0

SPEEDS = {getattr(termios, n): int(n[1:]) for n in dir(termios) if n[:1] == "B" and n[1:].isdigit()}
SIZES = {termios.CS5: 5, termios.CS6: 6, termios.CS7: 7, termios.CS8: 8}
CMSPAR = getattr(termios, "CMSPAR", 0o10000000000)


def line_settings(attrs):
    """(baud, data bits, RFC 2217 parity, RFC 2217 stop size, hardware flow) from tcgetattr()."""
    cflag = attrs[2]
    baud = SPEEDS.get(attrs[5], 9600)
    size = SIZES.get(cflag & termios.CSIZE, 8)
    if not cflag & termios.PARENB:
        parity = 1
    elif cflag & CMSPAR:
        parity = 4 if cflag & termios.PARODD else 5
    else:
        parity = 2 if cflag & termios.PARODD else 3
    stop = 2 if cflag & termios.CSTOPB else 1
    return baud, size, parity, stop, bool(cflag & termios.CRTSCTS)


def subnegotiation(what, value):
    return bytes([IAC, SB, COM_PORT, what]) + escape(value) + bytes([IAC, SE])


def setup(settings):
    """The RFC 2217 requests that set the port as [settings] say."""
    baud, size, parity, stop, flow = settings
    return (subnegotiation(SET_BAUDRATE, baud.to_bytes(4, "big"))
            + subnegotiation(SET_DATASIZE, bytes([size]))
            + subnegotiation(SET_PARITY, bytes([parity]))
            + subnegotiation(SET_STOPSIZE, bytes([stop]))
            + subnegotiation(SET_CONTROL, bytes([HW_FLOW if flow else NO_FLOW])))


def control_changes(old, new):
    """The SET-CONTROL values that take the lines (DTR, RTS) from [old]
    (None: unknown, send both) to [new]. RTS drops before DTR and DTR
    rises before RTS: with DTR off and RTS on, an ESP32's auto-reset
    circuit resets it, into its bootloader if DTR was on just before;
    switching from one line to the other passes through both off."""
    steps = [(1, False, RTS_OFF), (0, True, DTR_ON), (0, False, DTR_OFF), (1, True, RTS_ON)]
    return [value for line, on, value in steps
            if new[line] == on and (old is None or old[line] != on)]


def escape(data):
    return bytes(data).replace(b"\xff", b"\xff\xff")


class Unescaper:
    """Telnet's stream back to data: commands and subnegotiations are
    dropped (the answers to our requests), doubled IACs undone, also
    across reads."""

    def __init__(self):
        self.mode = "data"

    def feed(self, data):
        out = bytearray()
        for b in data:
            if self.mode == "data":
                if b == IAC:
                    self.mode = "iac"
                else:
                    out.append(b)
            elif self.mode == "iac":
                if b == IAC:
                    out.append(IAC)
                    self.mode = "data"
                elif b == SB:
                    self.mode = "sub"
                elif b in (DO, DONT, WILL, WONT):
                    self.mode = "option"
                else:
                    self.mode = "data"
            elif self.mode == "option":
                self.mode = "data"
            elif self.mode == "sub":
                if b == IAC:
                    self.mode = "sub-iac"
            elif self.mode == "sub-iac":
                self.mode = "data" if b == SE else "sub"
        return bytes(out)


def log(name, text):
    print(f"{time.strftime('%H:%M:%S')} {name}: {text}", file=sys.stderr, flush=True)


class Bridge:
    def __init__(self, name, tcp_port, folder, host="127.0.0.1"):
        self.name = name
        self.address = (host, tcp_port)
        self.link = os.path.join(folder, name)
        self.ctl_path = os.path.join(folder, f".{name}.ctl")
        self.ctl = None
        self.lines = (True, True)  # DTR, RTS: up while a program has it open, as on Linux
        self.master = None
        self.tty = None
        self.sock = None
        self.unescaper = None
        self.settings = None
        self.stopped = False
        self.retry_at = 0.0
        self.waiting = False
        self.waiting_path = os.path.join(os.path.dirname(self.link), f".{name}.waiting")

    def make_terminal(self):
        """The pseudo-terminal, raw at 9600 8N1 (as Linux leaves a fresh
        port, but without echo, which would send the board's output back
        to it), and its link."""
        self.master, slave = os.openpty()
        self.tty = os.ttyname(slave)
        tty.setraw(slave)
        attrs = termios.tcgetattr(slave)
        attrs[2] |= termios.CLOCAL | termios.CREAD
        attrs[4] = attrs[5] = termios.B9600
        termios.tcsetattr(slave, termios.TCSANOW, attrs)
        os.close(slave)
        os.set_blocking(self.master, False)
        self.settings = line_settings(termios.tcgetattr(self.master))
        tmp = os.path.join(os.path.dirname(self.link), f".{self.name}.tmp")
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(self.tty, tmp)
        os.replace(tmp, self.link)
        if os.path.lexists(self.ctl_path):
            os.unlink(self.ctl_path)
        self.ctl = socket.socket(socket.AF_UNIX)
        self.ctl.bind(self.ctl_path)
        self.ctl.listen(4)
        self.ctl.setblocking(False)

    def owns_link(self):
        try:
            return os.readlink(self.link) == self.tty
        except OSError:
            return False

    def set_waiting(self, waiting):
        """Marks the terminal as waiting for the port (`mynx usb` shows it), and says so once in the log."""
        if waiting == self.waiting:
            return
        self.waiting = waiting
        if waiting:
            open(self.waiting_path, "w").close()
            log(self.name, f"busy: another program has rfc2217://localhost:{self.address[1]}; "
                           f"{self.link} waits for it")
        else:
            try:
                os.unlink(self.waiting_path)
            except OSError:
                pass

    def remove_link(self):
        self.set_waiting(False)
        if self.ctl:
            self.ctl.close()
            self.ctl = None
            try:
                os.unlink(self.ctl_path)
            except OSError:
                pass
        if self.owns_link():
            try:
                os.unlink(self.link)
            except OSError:
                pass

    def control(self, command, value):
        """A control socket request: the lines as they are after it."""
        bits = (TIOCM_DTR if self.lines[0] else 0) | (TIOCM_RTS if self.lines[1] else 0)
        if command == "set":
            bits = value
        elif command == "bis":
            bits |= value
        elif command == "bic":
            bits &= ~value
        elif command != "get":
            return "error"
        old, self.lines = self.lines, (bool(bits & TIOCM_DTR), bool(bits & TIOCM_RTS))
        if self.sock is None:
            # Asked before this saw the program open the terminal: connect
            # now, with these lines, rather than raising both first.
            if self.opened()[0]:
                self.connect()
        elif old != self.lines:
            # The program may have changed the settings just before (the 1200
            # baud touch): the port gets them first, as it would on Linux.
            self.follow_settings()
            self.sock.sendall(b"".join(subnegotiation(SET_CONTROL, bytes([c]))
                                       for c in control_changes(old, self.lines)))
            log(self.name, f"DTR {'on' if self.lines[0] else 'off'}, RTS {'on' if self.lines[1] else 'off'}")
        bits = (TIOCM_DTR if self.lines[0] else 0) | (TIOCM_RTS if self.lines[1] else 0)
        return f"ok {bits | INPUTS}"

    def serve_control(self):
        """Answers the programs waiting on the control socket."""
        while True:
            try:
                conn, _ = self.ctl.accept()
            except (BlockingIOError, InterruptedError):
                return
            with conn:
                try:
                    conn.settimeout(1)
                    request = b""
                    while not request.endswith(b"\n") and len(request) < 100:
                        data = conn.recv(100)
                        if not data:
                            break
                        request += data
                    words = request.decode(errors="replace").split()
                    if len(words) == 2 and words[1].isdigit():
                        reply = self.control(words[0], int(words[1]))
                    else:
                        reply = "error"
                    conn.sendall(reply.encode() + b"\n")
                except OSError:
                    pass

    def wait(self, seconds):
        """Sleeps up to [seconds], answering control requests meanwhile."""
        if select.select([self.ctl], [], [], seconds)[0]:
            self.serve_control()

    def opened(self):
        """Whether a program has the terminal open, and whether it left bytes to send."""
        poll = select.poll()
        poll.register(self.master, select.POLLIN)
        events = dict(poll.poll(0)).get(self.master, 0)
        return not events & select.POLLHUP, bool(events & select.POLLIN)

    def connect(self):
        if time.monotonic() < self.retry_at:
            return False
        try:
            sock = socket.create_connection(self.address, timeout=2)
        except OSError as e:
            self.retry_at = time.monotonic() + RETRY
            log(self.name, f"the app's port isn't there ({e.strerror or e}); trying again")
            return False
        if refused(sock):
            sock.close()
            self.retry_at = time.monotonic() + RETRY
            self.set_waiting(True)
            return False
        self.set_waiting(False)
        self.sock = sock
        self.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.unescaper = Unescaper()
        self.settings = line_settings(termios.tcgetattr(self.master))
        self.sock.sendall(bytes([IAC, WILL, COM_PORT]) + setup(self.settings)
                          + b"".join(subnegotiation(SET_CONTROL, bytes([c]))
                                     for c in control_changes(None, self.lines)))
        log(self.name, f"opened at {self.settings[0]} baud")
        return True

    def disconnect(self, why):
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None
            log(self.name, why)

    def follow_settings(self):
        """Sends the terminal's settings when a program changed them."""
        now = line_settings(termios.tcgetattr(self.master))
        if now != self.settings:
            self.settings = now
            self.sock.sendall(setup(now))
            log(self.name, f"now {now[0]} baud")

    def from_terminal(self):
        """What the program wrote goes to the port; False when it has closed the terminal."""
        try:
            data = os.read(self.master, 4096)
        except BlockingIOError:
            return True
        except OSError as e:
            if e.errno == errno.EIO:
                return False
            raise
        if data and self.sock:
            self.follow_settings()
            self.sock.sendall(escape(data))
        return True

    def to_terminal(self):
        """The port's bytes go to the program; False when the app closed the connection."""
        try:
            data = self.sock.recv(4096)
        except OSError:
            return False
        if not data:
            return False
        data = self.unescaper.feed(data)
        try:
            os.write(self.master, data)
        except BlockingIOError:
            pass  # the program isn't reading: like a serial port's overrun, the bytes are lost
        except OSError as e:
            if e.errno != errno.EIO:
                raise
        return True

    def step(self, wait=0.25):
        """One round: connect while the terminal is open, pass bytes along, and let go once it's closed."""
        is_open, pending = self.opened()
        if self.sock is None:
            if not is_open:
                self.set_waiting(False)
            if is_open or pending:
                if self.connect():
                    return
            elif line_settings(termios.tcgetattr(self.master)) != self.settings:
                # Opened, changed and closed between two looks (`stty -F PORT
                # 1200`): the port gets it as an open and a close.
                if self.connect():
                    time.sleep(QUICK_OPEN)
                    self.closed()
                self.settings = line_settings(termios.tcgetattr(self.master))
            if pending and self.sock is None:
                # Nowhere to send it: drop it, as a port with no device would.
                self.from_terminal()
            self.wait(IDLE)
            return
        if not is_open and not pending:
            self.closed()
            return
        poll = select.poll()
        poll.register(self.master, select.POLLIN)
        poll.register(self.sock, select.POLLIN)
        poll.register(self.ctl, select.POLLIN)
        for fd, events in poll.poll(int(wait * 1000)):
            if self.sock is None:
                return
            if fd == self.ctl.fileno():
                self.serve_control()
            elif fd == self.master and events & select.POLLIN:
                self.from_terminal()
            elif fd == self.sock.fileno() and not self.to_terminal():
                self.disconnect("the app closed the port")
                self.retry_at = time.monotonic() + RETRY
                return
        if self.sock and is_open:
            self.follow_settings()
        if not is_open and self.sock:
            self.closed()

    def closed(self):
        self.disconnect("closed")
        self.lines = (True, True)

    def run(self):
        self.make_terminal()
        log(self.name, f"{self.link} -> {self.tty}, port {self.address[1]}")
        try:
            while not self.stopped:
                # The app takes the link away when the port goes, and a new
                # helper replaces it when it's back: this one must not reach
                # the new port (it would raise DTR and RTS) before it's stopped.
                if not self.owns_link():
                    self.disconnect("the port is gone")
                    break
                try:
                    self.step()
                except OSError as e:
                    self.disconnect(f"lost the port ({e.strerror or e})")
                    self.retry_at = time.monotonic() + RETRY
        finally:
            self.disconnect("stopped")
            self.remove_link()


def refused(sock):
    """Whether the app closed a new connection without greeting it: the port is busy."""
    try:
        if not select.select([sock], [], [], GREETING_WAIT)[0]:
            return False
        return sock.recv(1, socket.MSG_PEEK) == b""
    except OSError:
        return True


def main(argv):
    if len(argv) not in (3, 4) or not argv[2].isdigit():
        print("usage: serial-port NAME TCPPORT [FOLDER]", file=sys.stderr)
        return 2
    bridge = Bridge(argv[1], int(argv[2]), argv[3] if len(argv) == 4 else "/dev/serial")

    def stop(*_):
        bridge.stopped = True

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, stop)
    bridge.run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
