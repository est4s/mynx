#!/bin/sh
# Started by sound-server with Pulse's pid: tells the app which programs
# record, so it opens the phone's microphone only while one does. On
# every source or recording event it writes Pulse's sources and source
# outputs to $dir/inputs (the app watches the folder and reads it).
pulse=$1
dir=${MYNX_SOUND_DIR:-/tmp/.mynx/sound}
export PULSE_SERVER="unix:$dir/native"

alive() {
    [ "$(cat "/proc/$pulse/comm" 2>/dev/null)" = pulseaudio ] &&
        ! grep -q '^State:.*Z' "/proc/$pulse/status" 2>/dev/null
}

list() {
    { pactl list short sources && echo && pactl list source-outputs; } \
        >"$dir/.inputs" 2>/dev/null && mv -f "$dir/.inputs" "$dir/inputs"
}

# sound-server starts this just before it execs Pulse, and on a busy
# phone this can look first: give the exec a few seconds.
tries=10
while ! alive && [ -e "/proc/$pulse" ] && [ "$tries" -gt 0 ]; do
    tries=$((tries - 1))
    sleep 0.5
done

while alive; do
    if [ ! -e "$dir/native" ]; then
        sleep 0.2
        continue
    fi
    list
    # subscribe takes a while to connect (~1 s on a phone), and a
    # recording started meanwhile sends no event: list again after the
    # first event, poking Pulse with clients of our own until one comes.
    pactl subscribe 2>/dev/null | {
        while :; do pactl stat >/dev/null 2>&1; sleep 0.5; done &
        poke=$!
        while read -r line; do
            if [ -n "$poke" ]; then
                kill "$poke" 2>/dev/null
                poke=
                list
                continue
            fi
            # "on source" covers source-output too; sink events don't matter.
            case $line in *" on source"*) list ;; esac
        done
        [ -z "$poke" ] || kill "$poke" 2>/dev/null
    }
    alive && sleep 1
done
# Nothing records from a Pulse that has stopped.
rm -f "$dir/inputs" "$dir/.inputs"
